# ── Sensitive data (NEVER push these!) ──────────────────────────────
# NOTE: git does not support inline comments in .gitignore — a trailing
# "# ..." becomes part of the pattern and the line silently matches nothing.
# Keep comments on their own lines.
# Instagram session token:
data/session.json
# SQLite database (contains follower data):
data/instatracker.db
data/*.db
data/*.json

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ─────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

# ── Environment variables ────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── IDE / Editor ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────
*.log
logs/

# ── Claude Code (personal/local settings) ────────────────────────────
.claude/settings.local.json

# Yerel yapay zekâ asistanı dosyaları (yayımlanmaz)
CLAUDE.md
