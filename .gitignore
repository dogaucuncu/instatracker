# ── Sensitive data (NEVER push these!) ──────────────────────────────
# NOTE: git does not support inline comments in .gitignore — a trailing
# "# ..." becomes part of the pattern and the line silently matches nothing.
# Keep comments on their own lines.
# Everything the app writes at runtime lives in data/: the Instagram session
# token, the follower database, and whatever SQLite creates beside it. The
# folder is ignored as a whole and only .gitkeep is let back in. Listing files
# by name missed SQLite's write-ahead log (instatracker.db-wal / -shm), which
# holds recent follower data and is left behind whenever the server is stopped
# without a clean close — this repository is public.
data/*
!data/.gitkeep

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ─────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

# ── Environment variables ────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── IDE / Editor ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────
*.log
logs/

# ── Claude Code (personal/local settings) ────────────────────────────
.claude/settings.local.json

# Yerel yapay zekâ asistanı dosyaları (yayımlanmaz)
CLAUDE.md
